# Copy to .env (project root) and adjust. Never commit the real .env file.
ENVIRONMENT=development            # development | production
# REQUIRED in production. Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=720

# SQLite is the default (zero setup). For PostgreSQL use:
# DATABASE_URL=postgresql+psycopg://trafficvision:password@localhost:5432/trafficvision
# DATABASE_URL=

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Model + inference
YOLO_MODEL=yolo11n.pt              # yolo11n.pt (fast) | yolo11s.pt | yolo11m.pt (more accurate, slower)
DEVICE=auto                        # auto | cpu | cuda:0 | mps
MAX_UPLOAD_MB=500
MAX_CONCURRENT_VIDEO_JOBS=1

# Demo mode (simulated, clearly labelled data + demo accounts). Set false for a clean install.
SEED_DEMO_DATA=true
DEMO_ADMIN_EMAIL=admin@trafficvision.demo
DEMO_ADMIN_PASSWORD=Admin@12345
DEMO_OPERATOR_EMAIL=operator@trafficvision.demo
DEMO_OPERATOR_PASSWORD=Operator@12345
